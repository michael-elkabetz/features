{
  "name": "features",
  "version": "0.1.0",
  "description": "Create AI-powered features from your codebase — Chochmah, Binah, Da'at",
  "type": "module",
  "bin": {
    "features": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-elkabetz/features.git"
  },
  "scripts": {
    "build": "npx --yes tsup src/index.ts --format esm --dts --clean",
    "dev": "npx --yes tsup src/index.ts --format esm --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "ai",
    "knowledge",
    "claude",
    "codebase",
    "features",
    "agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "prompts"
  ]
}
